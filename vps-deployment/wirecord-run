#!/usr/bin/env bash
set -euo pipefail
WIRECORD_DIR="${WIRECORD_DIR:-/root/discord/wirecord}"
cd "$WIRECORD_DIR"
PYTHON="${WIRECORD_PYTHON:-$WIRECORD_DIR/venv/bin/python}"
MITM="${WIRECORD_MITM:-$WIRECORD_DIR/venv/bin/mitmdump}"
DISCORD="${WIRECORD_DISCORD:-discord}"
export PYTHONPATH="$WIRECORD_DIR${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p logs
"$PYTHON" -m discordless check-config
PORT=$("$PYTHON" -c 'from discordless.config import Config; print(Config.load().proxy_port)')
children=()
cleanup() {
    trap - EXIT TERM INT
    if ((${#children[@]})); then
        kill "${children[@]}" 2>/dev/null || true
        wait "${children[@]}" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT
"$MITM" -s discordless/addon.py --listen-host 127.0.0.1 --listen-port="$PORT" \
    --allow-hosts '^(((.+\.)?discord\.com)|((.+\.)?discordapp\.com)|((.+\.)?discord\.net)|((.+\.)?discordapp\.net)|((.+\.)?discord\.gg))(?::\d+)?$' \
    >>logs/mitmdump.log 2>&1 &
MITM_PID=$!
children+=("$MITM_PID")
"$PYTHON" - "$PORT" "$MITM_PID" <<'PY'
import os,socket,sys,time
deadline=time.monotonic()+60
while time.monotonic()<deadline:
    os.kill(int(sys.argv[2]),0)
    try:
        with socket.create_connection(('127.0.0.1',int(sys.argv[1])),timeout=1):
            break
    except OSError:
        time.sleep(.25)
else:
    raise SystemExit('Proxy did not become ready')
PY
"$DISCORD" --proxy-server="127.0.0.1:$PORT" --no-sandbox >>logs/discord.log 2>&1 &
children+=("$!")
watchdog() {
    sleep "${WIRECORD_STARTUP_GRACE:-120}"
    while true; do
        "$PYTHON" -m discordless health || return 1
        sleep 10
    done
}
watchdog &
children+=("$!")
set +e
wait -n "${children[@]}"
set -e
echo '[wirecord-run] A managed process exited or Gateway health failed; restarting service.'
exit 1
