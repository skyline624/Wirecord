[Unit]
Description=Wirecord — Discord traffic archiver + webhook forwarder
Documentation=https://github.com/skyline624/liberabot
After=network-online.target xvfb@99.service
Wants=network-online.target
Requires=xvfb@99.service
BindsTo=xvfb@99.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/discord/wirecord
Environment=DISPLAY=:99
Environment=PYTHONPATH=/root/discord/wirecord
ExecStart=/usr/local/bin/wirecord-run
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=20

# Hardening
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
